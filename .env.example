# IBKR Connection
IBKR_HOST=127.0.0.1
IBKR_PORT=7497          # 7497 = TWS Paper, 7496 = TWS Live, 4002 = IB Gateway Paper
IBKR_CLIENT_ID=1

# Symbols (comma-separated, STK only for now)
#SYMBOLS=AAPL,MSFT,TSLA,SPY,QQQ,NVDA,PLTR,BABA,AMD,NBIS,CRWV,RKLB
SYMBOLS=YMmain,GCmain,NQmain,ESmain,CLmain
# Bar settings
BAR_SIZE=15 mins         # ib_insync bar size string  (15-min improves signal-to-noise ratio)
HISTORY_BARS=500        # how many historical bars to seed on startup (500×15min ≈ 3+ trading weeks)

# Signal thresholds
BUY_THRESHOLD=0.4
SELL_THRESHOLD=-0.4

# Anti-flicker: number of consecutive consistent bars before emitting signal
CONFIRM_BARS=5          # 5×15min = 75-min confirmation window (was 2 — too weak)

# Dashboard refresh interval (seconds)
REFRESH_INTERVAL=15

# Opening-hour filter: skip the first N minutes after NYSE open (09:30 ET)
# Set to 0 to disable. Avoids the noisy open auction period.
OPEN_FILTER_MINUTES=30

# Auto-trading (DISABLED by default - set to true to enable)
AUTO_TRADE=false

# Auto-trading parameters (only used when AUTO_TRADE=true)
ATR_LIMIT_OFFSET=0.5    # limit price = mid ± ATR * this factor
MAX_POSITION_SIZE=100   # max shares per symbol
DAILY_LOSS_LIMIT=500    # circuit breaker: stop trading if daily PnL < -this value (USD)
ORDER_TIMEOUT=60        # seconds to wait for fill before cancelling

# Logging
LOG_FILE=logs/signals.log
LOG_LEVEL=INFO

# ── Factor System (FACTOR_MODE=true enables factor pipeline in main.py) ───────
FACTOR_MODE=false

# External data API keys
# FRED_API_KEY=            # Free key: https://fred.stlouisfed.org/docs/api/api_key.html

# Risk management (used by FactorBacktestEngine and live factor mode)
RISK_PER_TRADE=0.02        # Max fraction of equity to risk per trade (2%)
MAX_POSITION_PCT=0.20      # Max single-position size as fraction of equity (20%)
STOP_LOSS_ATR=2.0          # Stop-loss distance in ATR units
TAKE_PROFIT_ATR=4.0        # Take-profit distance in ATR units
TRAILING_STOP_ATR=1.5      # Trailing stop distance in ATR units
MAX_DRAWDOWN_PCT=0.10      # Portfolio circuit-breaker drawdown threshold (10%)
